# Path to subl CLI (defaults per platform if unset)
# macOS: /Applications/Sublime Text.app/Contents/SharedSupport/bin/subl
# Windows: %LOCALAPPDATA%\Programs\Sublime Text\subl.exe
# Linux: /usr/bin/subl
SUBLIME_EXE=

# Live Sublime Text session file (defaults to Auto Save Session.sublime_session)
# SUBLIME_SESSION_FILE=

# Default working folder for relative open/new paths
# (defaults to ~/Documents/Sublime-Notes if unset)
SUBLIME_WORKDIR=

# Where named session snapshots are stored
# SUBLIME_SESSION_STORAGE_DIR=
